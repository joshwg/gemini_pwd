[Unit]
Description=Gemini PWD Web Application
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=geminipwd
Group=geminipwd
WorkingDirectory=/opt/gemini-pwd
ExecStart=/opt/gemini-pwd/gemini-pwd
Environment=PORT=7000
# REQUIRED: PWD_SECRET_KEY and PWD_DB_FILE (absolute path). The service refuses
# to start without them. deploy.sh writes them to /etc/gemini_pwd.env and adds a
# drop-in (gemini_pwd.service.d/deploy.conf) with EnvironmentFile= and
# ReadWritePaths= for the database directory. To set them by hand instead, use
# `systemctl edit gemini_pwd`.
#Environment=PWD_DB_FILE=/absolute/path/to/passwords.db

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gemini-pwd
ReadWritePaths=/opt

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gemini-pwd

[Install]
WantedBy=multi-user.target
